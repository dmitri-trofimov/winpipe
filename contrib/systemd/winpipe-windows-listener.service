[Unit]
Description=winpipe bridge to persistent Windows listener

[Service]
Type=simple
ExecStart=%h/.local/bin/winpipe listen --listen 127.0.0.1:9222 --target 127.0.0.1:9223 --helper /mnt/c/dev/personal/winpipe/dist/winpipe.exe
Restart=on-failure
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=default.target
